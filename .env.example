# EasyPost (optional multi-carrier)
EASYPOST_API_KEY=

# UPS Developer Kit — https://developer.ups.com/
# Client ID + Secret from your UPS app
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# Shipper account number required to BUY labels
UPS_ACCOUNT_NUMBER=
# Set to "production" for live; omit or any other value = CIE (test) endpoints
UPS_ENV=

# Optional
AFTERSHIP_API_KEY=
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
USPS_USER_ID=
GITHUB_TOKEN=
