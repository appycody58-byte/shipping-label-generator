# Real Carrier Tracking API Keys
# Copy to .env and fill in to activate live data

# UPS Developer Kit (https://developer.ups.com/)
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# FedEx Developer (https://developer.fedex.com/)
FEDEX_API_KEY=
FEDEX_SECRET_KEY=

# USPS Web Tools (https://www.usps.com/business/web-tools-apis/)
USPS_USER_ID=

# AfterShip (multi-carrier powerhouse - https://www.aftership.com/)
AFTERSHIP_API_KEY=

# Optional: TrackingMore, EasyPost, ShipEngine, etc. can be added the same way
