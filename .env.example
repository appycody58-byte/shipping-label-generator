# Real Shipping Carrier API Keys
# Copy this file to .env and fill in the values you have

# UPS Developer Kit (https://developer.ups.com/) – FREE
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# FedEx Developer Portal (https://developer.fedex.com/) – FREE tier available
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
# or
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=

# USPS (https://developers.usps.com/)
USPS_USER_ID=

# AfterShip multi-carrier (https://www.aftership.com/) – free tier
AFTERSHIP_API_KEY=

# Optional GitHub token for issue → label generation
GITHUB_TOKEN=
